@startuml
skinparam style strictuml
title Activity Diagram - Aktor Kasir (Agri-POS)

|Kasir|
start
:Login ke Sistem;

|Sistem Agri-POS|
:Validasi Akun & Role (Kasir);
if (Akses Diberikan?) then (Ya)
  |Kasir|
  :Buka Transaksi Baru;
  repeat
    :Scan/Input Kode Produk;
    |Sistem Agri-POS|
    :Cek Stok Produk;
    if (Stok Tersedia?) then (Ya)
      :Tambahkan ke ShoppingCartMap;
    else (Tidak)
      :Tampilkan Pesan "Stok Kosong";
    endif
  |Kasir|
  repeat while (Input Item Lagi?) is (Ya)
  
  :Pilih Metode Pembayaran;
  |Sistem Agri-POS|
  if (Metode Digital?) then (E-Wallet/Transfer)
    :Validasi Pembayaran (Validatable);
  else (Cash)
    :Terima Uang & Hitung Kembalian;
  endif
  
  if (Transaksi Berhasil?) then (Ya)
    :Potong Stok Produk;
    :Simpan Data Transaksi;
    :Cetak Struk (Receiptable);
  else (Gagal)
    :Batalkan Transaksi;
  endif
else (Tidak)
  |Sistem Agri-POS|
  :Tampilkan Pesan Error;
  stop
endif

|Kasir|
stop
@enduml